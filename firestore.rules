rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function storedRole(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.role
        : null;
    }

    function isAdmin() {
      return isSignedIn() && storedRole(request.auth.uid) == 'admin';
    }

    function isCoach() {
      return isSignedIn() && storedRole(request.auth.uid) == 'coach';
    }

    function isStaff() {
      return isAdmin() || isCoach();
    }

    function privilegedFieldNames() {
      return ['role', 'points', 'rank', 'isActive'];
    }

    function serverFieldsUnchanged() {
      return request.resource.data.role == resource.data.role
          && request.resource.data.points == resource.data.points
          && request.resource.data.rank == resource.data.rank
          && request.resource.data.isActive == resource.data.isActive;
    }

    function validBooking(bookingId) {
      return request.resource.data.keys().hasAll([
               'bookingId',
               'uid',
               'facilityId',
               'facilityName',
               'date',
               'timeSlot',
               'status',
               'studentName',
               'paymentMethod'
             ])
          && request.resource.data.keys().hasOnly([
               'bookingId',
               'uid',
               'facilityId',
               'facilityName',
               'date',
               'timeSlot',
               'status',
               'studentName',
               'paymentMethod'
             ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.bookingId == bookingId
          && request.resource.data.facilityId is string
          && request.resource.data.facilityId.matches('^[A-Za-z0-9_-]{1,100}$')
          && request.resource.data.facilityName is string
          && request.resource.data.facilityName.size() > 0
          && request.resource.data.facilityName.size() <= 100
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.timeSlot is string
          && request.resource.data.timeSlot.matches('^[A-Za-z0-9 :_-]{1,40}$')
          && bookingId == request.resource.data.facilityId
            + '|' + request.resource.data.date
            + '|' + request.resource.data.timeSlot
          && request.resource.data.status == 'confirmed'
          && (request.resource.data.studentName == null
            || (request.resource.data.studentName is string
              && request.resource.data.studentName.size() <= 100))
          && request.resource.data.paymentMethod == 'pay_at_facility';
    }

    // ── users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      allow create: if isSelf(uid)
                    && request.resource.data.role == 'student'
                    && request.resource.data.points == 0
                    && request.resource.data.rank == 0
                    && request.resource.data.isActive == true;

      allow update: if isAdmin()
                    || (isSelf(uid) && serverFieldsUnchanged());

      allow delete: if isSelf(uid) || isAdmin();
    }

    // ── leaderboard ──────────────────────────────────────────────────────────
    match /leaderboard/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── events ───────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();

      match /enrollments/{enrolleeId} {
        allow read: if isSignedIn();
        allow create: if isSelf(enrolleeId) || isStaff();
        allow update, delete: if isSelf(enrolleeId) || isStaff();
      }
    }

    // ── bookings ─────────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isSignedIn()
                    && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                    && validBooking(bookingId);

      allow update: if isAdmin()
                    || (request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['status'])
                        && request.resource.data.uid == resource.data.uid
                        && (isStaff() || isSelf(resource.data.uid)))
                    || (resource.data.status == 'cancelled'
                        && isSignedIn()
                        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                        && isSelf(request.resource.data.uid)
                        && validBooking(bookingId));
      allow delete: if isStaff() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ── notifications ────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    // ── Remaining shared domains ─────────────────────────────────────────────
    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /coaches/{coachId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /achievements/{achievementId} {
      allow read: if isSignedIn();
      allow write: if isStaff() || isSelf(achievementId);
    }
  }
}
